STRATAONE_API_PORT=8080
STRATAONE_DASHBOARD_PORT=8088
STRATAONE_PROXY_PORT=8089
STRATAONE_ENVIRONMENT=development
STRATAONE_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
STRATAONE_SEED_EXAMPLE=false
STRATAONE_AUTH_ENABLED=true
STRATAONE_BOOTSTRAP_TOKEN=change-this-token
STRATAONE_ADMIN_PASSWORD=change-this-password
STRATAONE_API_TOKENS=
STRATAONE_TENANT_ENFORCEMENT=true
STRATAONE_RATE_LIMIT_ENABLED=true
STRATAONE_RATE_LIMIT_REQUESTS=120
STRATAONE_RATE_LIMIT_WINDOW_SECONDS=60
STRATAONE_HSTS_ENABLED=false
STRATAONE_CONTENT_SECURITY_POLICY=default-src 'self'; connect-src 'self' http://localhost:8080 http://127.0.0.1:8080; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'
STRATAONE_STATE_BACKEND=postgres
STRATAONE_POSTGRES_DSN=postgresql://strataone:strataone@postgres:5432/strataone
STRATAONE_EXECUTION_MODE=queued
STRATAONE_QUEUE_BACKEND=redis
STRATAONE_REDIS_URL=redis://redis:6379/0
STRATAONE_ENABLE_LIVE_REDFISH=false
STRATAONE_REQUIRE_OEM_VALIDATION=true
STRATAONE_REQUIRE_APPROVALS=true
STRATAONE_OEM_VALIDATION_FILE=.strataone/oem-validation.json
STRATAONE_ISO_LIBRARY_DIR=.strataone/iso-library
STRATAONE_ISO_LIBRARY_URL_PREFIX=
POSTGRES_USER=strataone
POSTGRES_PASSWORD=strataone
POSTGRES_DB=strataone

# Optional BMC credentials for inventory/preflight. Prefer file or Vault-backed secrets in production.
STRATAONE_VAULT_PROVIDER=env
STRATAONE_VAULT_FILE=
STRATAONE_VAULT_ADDR=
STRATAONE_VAULT_TOKEN=
STRATAONE_VAULT_PATH=secret/data/strataone
STRATAONE_BMC_USERNAME=
STRATAONE_BMC_PASSWORD=
